<h1> Discover Movies </h1>

<%= button_to "Discover Top Rated Movies", user_movies_path(@user), params: { top_rated: true }  %><br>
OR
<%= form_with url: user_movies_path(@user), local: true do |f| %>
  <%= f.label :search, 'Search Title' %>
  <%= f.text_field :search %>
  <%= f.submit 'Find Movies' %>
<% end %>